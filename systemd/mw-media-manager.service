[Unit]
Description=Genio middleware: camera, microphone and shared frame pool (MediaManager)
Documentation=file:///usr/share/doc/genio-mw/ARCHITECTURE.md
After=dbus.socket systemd-udevd.service
Requires=dbus.socket
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/mw-media-manager --config /etc/genio-mw/media.json
User=genio-mw
Group=genio-mw
# video: /dev/videoN and /dev/dma_heap (see 70-genio-mw.rules); audio: ALSA.
SupplementaryGroups=video audio

# A hung capture thread stops the watchdog ping and systemd restarts us.
WatchdogSec=10
Restart=on-failure
RestartSec=1

# Resource control. dma-buf memory is not charged to the cgroup, so this only
# bounds the heap of the process itself.
MemoryMax=512M
TasksMax=64
CPUWeight=200
OOMScoreAdjust=-200

# Hardening (the service needs only the bus and its devices).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_INET/AF_INET6: only for the optional UDP log sink (logging.json).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
# Shared log file directory /var/log/genio-mw (see config/logging.json).
LogsDirectory=genio-mw
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
