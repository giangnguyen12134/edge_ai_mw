[Unit]
Description=Genio middleware: relay of results and video to the Jetson Orin Nano (RoboticBridge, optional)
Documentation=file:///usr/share/doc/genio-mw/ARCHITECTURE.md
After=dbus.socket mw-media-manager.service mw-npu-manager.service network.target
Requires=dbus.socket
Wants=mw-media-manager.service mw-npu-manager.service
StartLimitIntervalSec=60
StartLimitBurst=10

# Optional component: not enabled by default.
#   sudo systemctl enable --now mw-robotic-bridge.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/mw-robotic-bridge --config /etc/genio-mw/robotic.json
User=genio-mw
Group=genio-mw

WatchdogSec=15
Restart=on-failure
RestartSec=2

MemoryMax=256M
TasksMax=32
CPUWeight=100

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX for the bus, AF_INET(6) for the link to the Jetson.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
# Shared log file directory /var/log/genio-mw (see config/logging.json).
LogsDirectory=genio-mw
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
