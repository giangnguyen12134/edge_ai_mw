{
  "bus": "system",
  "log_level": "info",

  "video": {
    "id": "camera0",
    "source": "v4l2",
    "device": "/dev/video0",
    "width": 640,
    "height": 480,
    "fps": 30,
    "pixel_format": "YUYV",
    "v4l2_buffers": 4,
    "pool_slots": 8,
    "pool_format": "native",
    "capture_io": "auto",
    "allocator": "dma_heap:system",
    "stall_timeout_ms": 3000
  },

  "audio": {
    "enabled": false,
    "id": "mic0",
    "source": "alsa",
    "device": "hw:1,0",
    "sample_rate": 16000,
    "channels": 1,
    "ring_ms": 3000,
    "period_ms": 20
  }
}
