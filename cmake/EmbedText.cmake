# Generates a C++ source file that defines a string constant holding the
# contents of a text file (used to embed the D-Bus introspection XML so the
# XML files in dbus/ stay the single source of truth).
#
#   mw_embed_text(<symbol> <input-file> <output-cc>)
#
# The generated file defines `const char <symbol>[]` in namespace mw::dbus
# (declared in mw/ipc/introspection.h). The build re-runs CMake when the input
# file changes.

function(mw_embed_text SYMBOL INPUT OUTPUT)
  file(READ "${INPUT}" MW_EMBED_CONTENT)
  file(WRITE "${OUTPUT}.tmp"
"// Generated by cmake/EmbedText.cmake from ${INPUT}. Do not edit.
#include \"mw/ipc/introspection.h\"

namespace mw {
namespace dbus {

const char ${SYMBOL}[] = R\"MWTEXT(${MW_EMBED_CONTENT})MWTEXT\";

}  // namespace dbus
}  // namespace mw
")
  # Only touch the real file when the content changed (keeps rebuilds quick).
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                  "${OUTPUT}.tmp" "${OUTPUT}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${INPUT}")
endfunction()
